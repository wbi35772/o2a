# ---------------------------------------------------------------------------
# warp-pool producer - all integration parameters are environment driven.
# ---------------------------------------------------------------------------

# Public host written into egress-ext.txt. Empty = auto-detect (EXTERNAL_HOST
# first, then the container/host primary IP). For InstaCloud set this to the
# service public TCP endpoint host (or leave empty to auto-detect).
EXTERNAL_HOST=
POOL_PUBLIC_HOST=
POOL_PRIVATE_HOST=
POOL_ID=

# SOCKS5 listener range. In mux mode keep START_PORT above MUX_PORT.
START_PORT=1081
POOL_SIZE=16
INSTANCE_COUNT=16
SOCKS_USER=warpuser
SOCKS_PASS=WarpPass2026

# Management plane (HTTP API + Web UI). Empty MUX_PORT = standalone mode:
# every wireproxy port is exposed directly and no control plane is started.
# When set, one listener multiplexes SOCKS (first byte 0x05) and HTTP.
MUX_PORT=
MUX_LISTEN=0.0.0.0
# Bind address for the individual wireproxy listeners (127.0.0.1 in mux mode).
WIREPROXY_BIND_HOST=0.0.0.0
# Bearer token for /api/v1/*. Empty disables the management API.
# Prefer injecting this as a service secret instead of writing it here.
API_TOKEN=

# Pool rotation (match the gateway 15-minute limitedUntil hard cooldown)
REROLL_INTERVAL=900
REROLL_BATCH=4
DEDUP_RETRIES=4
REGISTER_RETRIES=3
WGCF_KEEPALIVE=25

# Probing
PROBE_URL=https://opencode.ai/cdn-cgi/trace
PROBE_TIMEOUT=6
HEALTH_INTERVAL=300
MIN_HEALTHY=14

# Existing /48 families that must never appear (space separated)
DENY_48_PREFIXES=2a09:bac5:55 2a09:bac1:65 2a09:bac5:c82 2a09:bac1:27b 2a09:bac1:1e

# Build-time mirrors (leave defaults outside restricted networks)
# APK_MIRROR_HOST=mirrors.aliyun.com
# GOPROXY_URL=https://goproxy.cn,direct
