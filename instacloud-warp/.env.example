# Public IPv4 of this WARP node (written into egress-ext.txt)
EXTERNAL_HOST=

# SOCKS5 listener range
START_PORT=1081
POOL_SIZE=16
INSTANCE_COUNT=16
SOCKS_USER=warpuser
SOCKS_PASS=WarpPass2026

# Pool rotation (match the gateway 15-minute limitedUntil hard cooldown)
REROLL_INTERVAL=900
REROLL_BATCH=4
DEDUP_RETRIES=4
REGISTER_RETRIES=3
WGCF_KEEPALIVE=25

# Probing
PROBE_URL=https://opencode.ai/cdn-cgi/trace
PROBE_TIMEOUT=6
HEALTH_INTERVAL=300

# Existing /48 families that must never appear (space separated)
DENY_48_PREFIXES=2a09:bac5:55 2a09:bac1:65 2a09:bac5:c82 2a09:bac1:27b 2a09:bac1:1e

# Build-time mirrors (leave defaults outside restricted networks)
# APK_MIRROR_HOST=mirrors.aliyun.com
# GOPROXY_URL=https://goproxy.cn,direct
