# ---- shared ----
DATA_ROOT=./data
TZ=UTC

# ---- core: WARP pool ----
# Number of wireproxy instances (WARP exits). 16 keeps the pool mux on 1081 and
# leaves 1594-1648 free for relay sessions.
POOL_SIZE=16
# First local wireproxy port. Pool occupies POOL_START_PORT..+POOL_SIZE-1.
POOL_START_PORT=1578
SOCKS_USER=warpuser
SOCKS_PASS=change-me-socks-password
POOL_ID=local
# Host written into /api/v1/endpoints. 127.0.0.1 is correct when the gateway
# runs on the same Docker host. For a remote gateway use the pool's LAN address.
POOL_PRIVATE_HOST=127.0.0.1
POOL_PUBLIC_HOST=127.0.0.1
# Bearer token for the pool management API (/api/v1/*).
POOL_API_TOKEN=change-me-pool-token
MIN_HEALTHY=14

# ---- core: relay ----
# Trojan/WS relay sessions pulled from a subscription. Leave RELAY_SUB_URL
# empty to run the pool without a relay (the watchdog stays idle).
RELAY_PORT_BASE=1594
RELAY_MUX_PORT=11081
RELAY_API_TOKEN=147258hyh
RELAY_SUB_URL=
RELAY_MAX_AUTO=100
RELAY_SUB_SYNC_INTERVAL=1800
RELAY_PRIVATE_HOST=127.0.0.1
RELAY_PUBLIC_HOST=
# Never use 162.159.192.121; it is permanently blocked.
WG_ENDPOINT_HOST=162.159.192.1

# ---- core: gateway ----
# Applied only when config.json does not exist yet (fresh volume).
ADMIN_PASS=change-this-admin-password
SERVER_KEY=change-this-server-key
POOL_SYNC_INTERVAL=60
RELAY_EGRESS_INTERVAL=60

# ---- edge: Xray node ----
EDGE_PORT=8443
EDGE_NODE_PORT=8443
EDGE_WS_PATH=/proxy
EDGE_UUID=
# 443 + TLS when a reverse proxy terminates TLS; use EDGE_PUBLIC_TLS=0 and
# EDGE_PUBLIC_PORT=EDGE_PORT for direct plain HTTP.
EDGE_PUBLIC_PORT=443
EDGE_PUBLIC_TLS=1

# ---- tools: checker ----
CHECKER_PORT=8199
CHECKER_MAX_BATCH=64
CHECKER_TIMEOUT_MS=5000
CHECKER_TOKEN=

# ---- build mirrors (optional) ----
# APK_MIRROR_HOST=dl-cdn.alpinelinux.org
# GOPROXY_URL=https://proxy.golang.org,direct
# SING_BOX_ARCH=amd64
