#!/bin/sh
# proxyctl turns subscription providers into a local SOCKS fleet and points
# opencode2api at it. Subcommands:
#   sync   fetch every enabled provider, merge nodes, rebuild the fleet
#   apply  rebuild the fleet from the saved node cache and selection
#   start  apply when a cache exists, otherwise sync (boot entry point)
#   status print a one-line summary as KEY=VALUE pairs
set -eu

state_dir=${STATE_DIR:-/var/lib/opencode2api}
work_dir=${PROXY_WORK_DIR:-$state_dir/cfnew}
pc_dir=$state_dir/proxycenter
providers_file=$pc_dir/providers.txt
settings_file=$pc_dir/settings.env
selected_file=$pc_dir/selected.txt
listeners_file=$pc_dir/listeners.json
merged_file=$pc_dir/merged.json
log_file=$work_dir/mihomo.log
pid_file=$work_dir/mihomo.pid

node_count=600
port_base=21000
if [ -f "$settings_file" ]; then
    # shellcheck disable=SC1090
    . "$settings_file"
fi

log() { printf '%s\n' "$*"; }

mkdir -p "$pc_dir" "$work_dir"

# seed_providers imports the legacy cfnew-sub.txt when the panel has no
# providers yet, so an existing deployment keeps working after the upgrade.
seed_providers() {
    [ -s "$providers_file" ] && return 0
    [ -s "$state_dir/cfnew-sub.txt" ] || return 0
    index=1
    : > "$providers_file"
    while IFS= read -r url; do
        url=$(printf '%s' "$url" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -n "$url" ] || continue
        printf 'p%s\tsubscription %s\t%s\n' "$index" "$index" "$url" >> "$providers_file"
        index=$((index + 1))
    done < "$state_dir/cfnew-sub.txt"
}

kill_mihomo() {
    if [ -f "$pid_file" ]; then
        pid=$(cat "$pid_file" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            i=0
            while [ $i -lt 20 ] && kill -0 "$pid" 2>/dev/null; do
                i=$((i + 1))
                sleep 0.2
            done
            kill -9 "$pid" 2>/dev/null || true
        fi
        rm -f "$pid_file"
    fi
    pkill -f '/usr/local/bin/mihomo' 2>/dev/null || true
    sleep 0.3
}

wait_port() {
    hex=$(printf '%04X' "$1")
    i=0
    while [ $i -lt 60 ]; do
        if grep -q ":$hex " /proc/net/tcp 2>/dev/null; then
            return 0
        fi
        i=$((i + 1))
        sleep 0.5
    done
    return 1
}

# fetch_providers downloads every enabled provider as Clash YAML. A failing
# provider is reported and skipped; the sync only fails when nothing is left.
fetch_providers() {
    rm -f "$pc_dir"/sub-*.yaml "$pc_dir"/sub-*.json
    fetched=0
    index=0
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        id=$(printf '%s' "$line" | cut -f1)
        url=$(printf '%s' "$line" | cut -f3)
        [ -n "$url" ] || continue
        index=$((index + 1))
        out=$pc_dir/sub-$index.yaml
        sep='?'
        case "$url" in
            *\?*) sep='&' ;;
        esac
        if wget -q -O "$out" -T 40 -U 'clash.meta' "$url${sep}target=clash" && [ -s "$out" ]; then
            log "provider $id fetched ($(wc -c < "$out" | tr -d ' ') bytes)"
            fetched=$((fetched + 1))
        else
            rm -f "$out"
            log "provider $id failed"
        fi
    done < "$providers_file"
    [ "$fetched" -gt 0 ]
}

build_merged() {
    set -- "$pc_dir"/sub-*.json
    [ -f "$1" ] || return 1
    jq -s '[range(0; length) as $i | .[$i].proxies[] | .name = ("s" + ($i | tostring) + "-" + (.name // "node"))]' "$@" > "$merged_file"
    [ -s "$merged_file" ]
}

# build_fleet writes mihomo.yaml, listeners.json and proxies.txt from the
# merged cache: the saved selection when there is one, otherwise an even
# sample of node_count nodes.
build_fleet() {
    want=$node_count
    if [ -s "$selected_file" ]; then
        jq -r '.name' "$merged_file" > "$work_dir/all-names.txt"
        awk 'NR==FNR { if ($0 !~ /^#/ && length($0) > 0) want[$0]=1; next } want[$0] { print $0 }' \
            "$selected_file" "$work_dir/all-names.txt" > "$work_dir/keep.txt"
        if [ -s "$work_dir/keep.txt" ]; then
            jq --rawfile keep "$work_dir/keep.txt" \
                '[($keep | split("\n") | map(select(length > 0)) | .[]) as $n | .[] | select(.name == $n)]' \
                "$merged_file" > "$work_dir/chosen.json"
        fi
    fi
    if [ ! -s "$work_dir/chosen.json" ]; then
        jq --argjson want "$want" \
            '. as $all | ($all | length) as $total
             | (if $total == 0 then []
                elif $total <= $want then [range(0; $total)]
                else [range(0; $want) | (. * $total / $want | floor)] end) as $idx
             | [$idx[] as $i | $all[$i]]' "$merged_file" > "$work_dir/chosen.json"
    fi

    jq --argjson base "$port_base" '
        . as $all
        | {mode: "direct",
           proxies: $all,
           listeners: [range(0; ($all | length)) as $i
             | {name: ("o2a-" + ($i | tostring)), type: "socks",
                listen: "127.0.0.1", port: ($base + $i), udp: false,
                proxy: $all[$i].name}]}
    ' "$work_dir/chosen.json" > "$work_dir/mihomo.json"

    jq -r '.listeners[] | [.name, .port, .proxy] | @tsv' "$work_dir/mihomo.json" > "$work_dir/ports.tsv"
    jq -r '.listeners[] | "socks5://127.0.0.1:" + (.port | tostring)' "$work_dir/mihomo.json" > "$work_dir/proxies.txt"
    jq -r '.proxies[] | .name' "$work_dir/mihomo.json" > "$selected_file"

    jq -r --slurpfile m "$work_dir/mihomo.json" '
        .proxies as $p
        | $m[0].listeners
        | map(. as $l | ($p[] | select(.name == $l.proxy)) as $node
            | {name: $l.proxy, provider: ($l.proxy | split("-")[0]),
               type: $node.type, server: $node.server, port: $node.port,
               listen_port: $l.port})
    ' "$work_dir/chosen.json" > "$listeners_file"

    yq -p=json -o=yaml '.' "$work_dir/mihomo.json" > "$work_dir/mihomo.yaml"
    log "fleet built: $(jq '.listeners | length' "$work_dir/mihomo.json") listeners on 127.0.0.1:$port_base+"
}

start_mihomo() {
    kill_mihomo
    nohup /usr/local/bin/mihomo -d "$work_dir" -f "$work_dir/mihomo.yaml" >> "$log_file" 2>&1 &
    echo $! > "$pid_file"
    last=$((port_base + $(jq '.listeners | length' "$work_dir/mihomo.json") - 1))
    if wait_port "$last"; then
        log "mihomo ready pid $(cat "$pid_file")"
    else
        log "mihomo did not open port $last in time"
        return 1
    fi
}

write_config() {
    config_path=${CONFIG_PATH:-$state_dir/config.json}
    [ -f "$config_path" ] || return 0
    jq --arg pf "$work_dir/proxies.txt" \
        '.warp.enabled = false | .proxies = [] | .proxyfile = $pf' \
        "$config_path" > "$config_path.tmp" && mv "$config_path.tmp" "$config_path"
}

do_apply() {
    [ -s "$merged_file" ] || { log "no node cache"; return 1; }
    rm -f "$work_dir/chosen.json"
    build_fleet
    start_mihomo
    write_config
}

do_sync() {
    seed_providers
    kill_mihomo
    fetch_providers || { log "no provider reachable"; return 1; }
    for yaml in "$pc_dir"/sub-*.yaml; do
        yq -p=yaml -o=json '.' "$yaml" > "${yaml%.yaml}.json" || rm -f "${yaml%.yaml}.json"
    done
    rm -f "$selected_file"
    build_merged || { log "no proxies in providers"; return 1; }
    do_apply
}

case "${1:-start}" in
    sync) do_sync ;;
    apply) do_apply ;;
    start)
        if [ -s "$merged_file" ]; then
            do_apply || do_sync
        else
            do_sync
        fi
        ;;
    status)
        pid=$(cat "$pid_file" 2>/dev/null || echo 0)
        count=0
        [ -s "$work_dir/mihomo.json" ] && count=$(jq '.listeners | length' "$work_dir/mihomo.json")
        alive=0
        kill -0 "$pid" 2>/dev/null && alive=1
        printf 'MIHOMO_PID=%s\nMIHOMO_ALIVE=%s\nLISTENERS=%s\nPORT_BASE=%s\n' "$pid" "$alive" "$count" "$port_base"
        ;;
    *)
        log "usage: proxyctl {sync|apply|start|status}"
        exit 2
        ;;
esac
